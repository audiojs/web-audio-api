{
  "name": "web-audio-api",
  "version": "1.5.6",
  "description": "Pure JavaScript Web Audio API for Node, CI, and servers",
  "author": "Sébastien Piquemal <sebpiq@gmail.com>",
  "contributors": [
    "Dmitry Iv <df.creative@gmail.com>"
  ],
  "repository": "audiojs/web-audio-api",
  "homepage": "https://audiojs.dev/web-audio-api/",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.js",
    "./polyfill": "./polyfill.js"
  },
  "types": "./index.d.ts",
  "files": [
    "src",
    "examples/*.js",
    "examples/graphs",
    "bin.js",
    "index.js",
    "index.d.ts",
    "polyfill.js",
    "README.md"
  ],
  "keywords": [
    "audio",
    "audiojs",
    "sound",
    "music",
    "web audio",
    "web audio api",
    "waa",
    "dsp"
  ],
  "dependencies": {
    "@audio/decode": "^3.15.0",
    "@audio/speaker": "^2.3.3",
    "audio-buffer": "^7.3.0",
    "audio-effect": "^1.0.0",
    "automation-events": "^7.1.19",
    "digital-filter": "^2.3.0",
    "fourier-transform": "^2.2.0",
    "pcm-convert": "^3.1.1",
    "periodic-function": "^2.1.0"
  },
  "devDependencies": {
    "@audio/assert": "^0.2.0",
    "@audio/pitch-yin": "^1.0.4",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.12",
    "node-web-audio-api": "^1.0.8",
    "playwright": "1.58.2",
    "tone": "^15.1.22",
    "tst": "^9.4.0"
  },
  "peerDependencies": {
    "@audio/mic": "^1.1.3"
  },
  "peerDependenciesMeta": {
    "@audio/mic": {
      "optional": true
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/index.js",
    "bench": "node benchmark/run.js",
    "bench:compare": "node benchmark/compare.js",
    "bench:all": "node benchmark/run-all.js",
    "wpt": "node test/wpt-runner.js",
    "wpt:parallel": "TST_PARALLEL=8 node test/wpt.test.js",
    "site:build": "node scripts/build-site.mjs",
    "site:stage": "node scripts/build-site.mjs --stage",
    "site:verify": "node scripts/build-site.mjs --verify --stage",
    "site:serve": "python3 -m http.server 8080 --directory build/site",
    "test:site": "node test/site.test.js && node test/signal.test.js",
    "test:site:browser": "node test/site-browser.mjs",
    "test:music": "node test/music.test.js",
    "prepublishOnly": "npm test"
  },
  "funding": "https://github.com/sponsors/audiojs",
  "bin": {
    "web-audio-api": "./bin.js"
  }
}
